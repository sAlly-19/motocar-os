{
  "expo": {
    "name": "MotoCar",
    "slug": "motocar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "motocar",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motocar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MotoCar precisa da câmera para escanear placas de veículos e documentos.",
        "NSPhotoLibraryUsageDescription": "MotoCar precisa acessar suas fotos para adicionar imagens de peças e veículos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031636",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.motocar.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
